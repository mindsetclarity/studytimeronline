---
import { BRAND } from "../lib/brand";
import { TRUST_LINKS, isCurrent } from "../lib/navigation";

const pathname = Astro.url.pathname;

const isFooterActive = (href: string) => {
  if (isCurrent(pathname, href)) return true;
  if (href === "/privacy" && pathname.includes("privacy")) return true;
  if (href === "/terms" && pathname.includes("terms")) return true;
  return false;
};
---

<footer class="site-footer">
  <div class="container-page site-footer__grid site-footer__grid--simple">
    <section class="site-footer__brand" aria-labelledby="footer-brand">
      <h2 id="footer-brand" translate="no">{BRAND}</h2>
      <p>A calm study timer for focused students.</p>
    </section>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul class="site-footer__legal">
        {TRUST_LINKS.map((link) => {
          const active = isFooterActive(link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={active ? "page" : undefined}
                class:list={[{ "is-active": active }]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</footer>