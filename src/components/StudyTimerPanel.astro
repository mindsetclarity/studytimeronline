---
/**
 * The countdown cockpit: duration chips, split-flap clock, controls, summary.
 * Shared by `/` and `/timer`, which is why the styles live here rather than
 * being pasted into each page. Behaviour comes from scripts/study-cockpit.ts,
 * which binds to the `data-*` hooks below.
 */
interface Props {
  /** Headline above the timer. Omit on `/`, where the page h1 already says it. */
  title?: string;
  titleTag?: "h1" | "h2";
  subtitle?: string;
  defaultMinutes?: number;
}

const { title, titleTag = "h1", subtitle, defaultMinutes = 45 } = Astro.props;
const Title = titleTag;
const PRESETS = [15, 25, 30, 45, 60];
---

<section class="study-cockpit-page" data-study-cockpit data-study-fixed-mode="countdown">
  <div class="container-page timer-shell">

    {(title || subtitle) && (
      <header class="timer-shell__head">
        {title && <Title class="timer-shell__title">{title}</Title>}
        {subtitle && <p class="timer-shell__subtitle">{subtitle}</p>}
      </header>
    )}

    <!-- Duration sits above the clock so the flow reads choose → see → start. -->
    <div class="timer-shell__durations" data-duration-setup>
      <div class="duration-chips-row" aria-label="Select time">
        {PRESETS.map((minutes) => (
          <button class="compact-chip chip" type="button" data-preset-minutes={minutes}>{minutes} min</button>
        ))}

        <div class="compact-chip-custom" title="Set your own length">
          <input
            id="cockpit-duration"
            name="duration-minutes"
            type="number"
            min="1"
            max="360"
            value={defaultMinutes}
            data-duration
            aria-label="Custom time in minutes"
          />
          <label for="cockpit-duration">min</label>
        </div>
      </div>
    </div>

    <section class="timer-panel-compact study-timer-stage" data-study-stage data-display-card>
      <div class="voice-toggle-wrapper">
        <span class="voice-label" id="voice-toggle-label">Voice</span>
        <button
          type="button"
          class="voice-switch"
          role="switch"
          aria-checked="true"
          aria-labelledby="voice-toggle-label"
          data-voice-toggle
        >
          <span class="voice-switch-ball"></span>
        </button>
      </div>

      <div class="timer-shell__state-row">
        <span class="timer-cockpit__state" data-session-state>Ready</span>
      </div>

      <div class="study-timer-stage__clock" aria-live="polite">
        <div class="study-timer-stage__aura" aria-hidden="true"></div>

        <div class="timer-display" data-timer-display data-flip-clock>{`${String(defaultMinutes).padStart(2, "0")}:00`}</div>

        <p class="study-timer-stage__detail" data-session-detail>{defaultMinutes}-minute focused study block</p>

        <div class="compact-progress-track progress-track" data-progress-wrap aria-hidden="true">
          <div class="compact-progress-fill progress-fill" data-progress-fill></div>
        </div>
      </div>

      <div class="compact-controls-wrapper" aria-label="Study timer controls">
        <!-- Start and Pause swap: the disabled one is hidden by CSS. -->
        <button class="btn-primary compact-btn-primary" type="button" data-start>Start Timer</button>
        <button class="btn-primary compact-btn-primary" type="button" data-pause disabled>Pause</button>

        <button class="compact-btn-secondary" type="button" data-reset disabled>Reset</button>
        <button class="compact-btn-secondary" type="button" data-fullscreen aria-label="Enter fullscreen">Fullscreen</button>
      </div>

      <p class="shortcut-hint">
        <kbd>Space</kbd> start / pause <span aria-hidden="true">·</span>
        <kbd>R</kbd> reset <span aria-hidden="true">·</span>
        <kbd>F</kbd> fullscreen
      </p>
    </section>

    <section
      class="timer-panel-compact study-session-summary"
      aria-labelledby="study-summary-title"
      data-session-summary
      hidden
      tabindex="-1"
    >
      <p class="timer-shell__eyebrow">Timer complete</p>
      <h2 id="study-summary-title" class="timer-shell__summary-title">Good work. Take a short break.</h2>

      <!-- Filled in by study-cockpit.ts once the session is saved. -->
      <div class="session-progress" data-summary-progress hidden>
        <div class="session-progress__stat">
          <strong data-progress-today>0 min</strong>
          <span>today</span>
        </div>
        <div class="session-progress__stat">
          <strong data-progress-sessions>0</strong>
          <span data-progress-sessions-label>sessions</span>
        </div>
        <div class="session-progress__stat">
          <strong data-progress-streak>0</strong>
          <span data-progress-streak-label>day streak</span>
        </div>
      </div>
      <a class="session-progress__link" href="/study-stats" data-summary-stats-link hidden>See your stats →</a>

      <div class="compact-controls-wrapper">
        <button class="btn-primary compact-btn-primary" type="button" data-start-another>Start Again</button>
        <button class="compact-btn-secondary" type="button" data-reset>Reset</button>
      </div>
    </section>

  </div>
</section>

<script>
  import "../scripts/study-cockpit";
</script>

<style>
  /* global.css still sizes these for an older three-row grid layout — a 710px
     stage with a 410px clock well, plus 4xl/6xl page padding. On this flex
     column that only pushes Start below the fold. */
  .study-cockpit-page {
    padding-block: 0;
    min-height: 0;
  }

  .timer-shell {
    padding: 0.75rem 1rem 2.5rem;
  }

  .timer-shell__head {
    text-align: center;
    margin-bottom: 1rem;
  }

  .timer-shell__title {
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    font-weight: 600;
    margin: 0;
  }

  .timer-shell__subtitle {
    color: var(--text-secondary, #94a3b8);
    font-size: 0.95rem;
    margin: 0.4rem 0 0;
  }

  .timer-shell__durations {
    max-width: 560px;
    margin: 0 auto 1rem;
    text-align: center;
  }

  .timer-shell__state-row {
    margin-bottom: 8px;
  }

  .timer-cockpit__state {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--brand);
    border: 1px solid currentColor;
    padding: 0.2rem 0.6rem;
    border-radius: 12px;
    font-weight: 600;
  }

  .timer-shell__eyebrow {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary, #94a3b8);
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .timer-shell__summary-title {
    font-size: 1.35rem;
    font-weight: 600;
    margin: 0 0 1.25rem;
    color: var(--text-primary, #fff);
  }

  .timer-panel-compact {
    background: var(--surface-glass, rgba(30, 30, 30, 0.4));
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.08));
    border-radius: 24px;
    padding: 32px;
    margin: 0 auto;
    max-width: 560px;
    width: 100%;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
  }

  .study-session-summary {
    margin-top: 2rem;
  }

  .session-progress {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 10px;
    width: 100%;
    margin: 0 0 12px;
  }

  .session-progress[hidden],
  .session-progress__link[hidden] {
    display: none;
  }

  .session-progress__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 8px;
    border-radius: 14px;
    background: var(--overlay-04);
    border: 1px solid var(--overlay-08);
  }

  .session-progress__stat strong {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--content-heading);
    font-variant-numeric: tabular-nums;
  }

  .session-progress__stat span {
    font-size: 0.75rem;
    color: var(--content-body);
  }

  .session-progress__link {
    display: inline-block;
    margin: 0 0 1.25rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--brand);
    text-decoration: none;
  }

  .session-progress__link:hover {
    text-decoration: underline;
  }

  @media (max-width: 600px) {
    .timer-panel-compact {
      padding: 24px 20px;
      border-radius: 20px;
    }
  }

  .timer-panel-compact.study-timer-stage {
    min-height: 0;
    display: flex;
    gap: 0;
  }

  .timer-panel-compact .study-timer-stage__clock {
    min-height: 0;
    width: 100%;
    container-type: inline-size; /* the flip clock sizes itself off this */
    padding: 8px 0 0;
    border: none;
    background: none;
    box-shadow: none;
    overflow: visible; /* the flip cards rotate out of the box */
  }

  .study-timer-stage__detail {
    color: var(--text-secondary, #94a3b8);
    font-size: 0.9rem;
    margin: 0;
  }

  /* Start and Pause occupy the same slot — hide whichever is disabled. */
  .compact-controls-wrapper button[data-start]:disabled,
  .compact-controls-wrapper button[data-pause]:disabled {
    display: none !important;
  }

  .compact-controls-wrapper {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px;
    margin-top: 24px;
    width: 100%;
  }

  .study-session-summary .compact-controls-wrapper {
    margin-top: 0;
  }

  /* A shortcut nobody knows about is not a feature. Hidden on touch layouts,
     where there is no keyboard to press. */
  .shortcut-hint {
    display: none;
    margin: 16px 0 0;
    font-size: 0.75rem;
    color: var(--text-secondary, #94a3b8);
  }

  .shortcut-hint kbd {
    font: inherit;
    font-weight: 600;
    color: var(--text-primary, #e2e8f0);
    background: var(--overlay-06);
    border: 1px solid var(--overlay-10);
    border-radius: 5px;
    padding: 1px 6px;
  }

  @media (min-width: 601px) and (pointer: fine) {
    .shortcut-hint {
      display: block;
    }
  }

  .compact-btn-primary {
    height: 52px;
    padding: 0 24px;
    font-size: 1.05rem;
    font-weight: 600;
    border-radius: 14px;
    flex-grow: 1;
    min-width: 140px;
    max-width: 260px;
  }

  .compact-btn-secondary {
    height: 48px;
    padding: 0 20px;
    font-size: 0.9rem;
    font-weight: 500;
    border-radius: 12px;
    background: transparent;
    border: 1px solid var(--border-color, rgba(255, 255, 255, 0.15));
    color: var(--text-secondary, #aaa);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .compact-btn-secondary:hover:not(:disabled) {
    border-color: var(--text-primary, #fff);
    color: var(--text-primary, #fff);
    background: var(--overlay-05);
  }

  .compact-progress-track {
    width: 100%;
    height: 4px;
    background: var(--overlay-08);
    border-radius: 2px;
    margin: 12px 0 0 0;
    overflow: hidden;
  }

  .compact-progress-fill {
    height: 100%;
    background: var(--gradient-primary, linear-gradient(to right, var(--brand-bright), var(--brand)));
    width: 0%;
    transition: none;
  }

  .duration-chips-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    width: 100%;
  }

  .compact-chip {
    height: 36px;
    padding: 0 12px;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: 8px;
    background: var(--overlay-04);
    border: 1px solid transparent;
    color: var(--text-secondary, #999);
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .compact-chip:hover:not(:disabled) {
    background: var(--overlay-08);
    color: var(--text-primary, #ddd);
  }

  .compact-chip[aria-pressed="true"]:not(:disabled) {
    background: var(--brand-a10);
    border-color: var(--brand-a40);
    color: var(--brand);
  }

  .compact-chip:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .compact-chip-custom {
    display: flex;
    align-items: center;
    height: 36px;
    padding-right: 10px;
    background: var(--brand-a05);
    border-radius: 8px;
    border: 1px solid var(--brand-a35);
    cursor: pointer;
    transition: border-color 0.2s ease, background-color 0.2s ease, opacity 0.2s ease;
  }

  .compact-chip-custom input {
    background: transparent;
    border: none;
    outline: none;
    width: 44px;
    height: 100%;
    padding: 0 0 0 10px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-primary, #fff);
  }

  .compact-chip-custom label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-secondary, #999);
    cursor: text;
    margin-left: 2px;
  }

  .compact-chip-custom:hover:not(.is-disabled) {
    background: var(--brand-a10);
    border-color: var(--brand-a50);
  }

  .compact-chip-custom[aria-pressed="true"]:not(.is-disabled),
  .compact-chip-custom:focus-within:not(.is-disabled) {
    border-color: var(--brand-a75);
    background: var(--brand-a15);
  }

  .compact-chip-custom[aria-pressed="true"]:not(.is-disabled) :is(input, label),
  .compact-chip-custom:focus-within:not(.is-disabled) :is(input, label) {
    color: var(--brand);
  }

  .compact-chip-custom.is-disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  /* VOICE TOGGLE */
  .voice-toggle-wrapper {
    position: absolute;
    top: 20px;
    right: 20px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  @media (max-width: 600px) {
    .voice-toggle-wrapper {
      top: 16px;
      right: 16px;
    }
  }

  .voice-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary, #888);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .voice-switch {
    position: relative;
    width: 40px;
    height: 22px;
    padding: 0;
    background: var(--overlay-08);
    border-radius: 11px;
    border: 1px solid var(--overlay-05);
    cursor: pointer;
    transition: background 0.3s ease;
    outline: none;
  }

  .voice-switch:focus-visible {
    box-shadow: 0 0 0 2px var(--brand);
  }

  .voice-switch[aria-checked="true"] {
    background: var(--brand-a15);
    border-color: var(--brand-a30);
  }

  .voice-switch-ball {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 16px;
    height: 16px;
    background: var(--text-secondary, #888);
    border-radius: 50%;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), background 0.3s ease;
  }

  .voice-switch[aria-checked="true"] .voice-switch-ball {
    transform: translateX(18px);
    background: var(--brand);
  }

  /* FULLSCREEN */
  .study-timer-stage[data-fullscreen="true"] {
    display: flex !important;
    flex-direction: column;
    justify-content: center;
    align-items: center !important;
    max-width: none !important;
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    background: #0a0a0a !important;
    padding: 24px !important;
    min-height: 100dvh !important;
    width: 100vw !important;
  }

  .study-timer-stage[data-fullscreen="true"] .flip-clock {
    --flip-size: clamp(90px, 20vh, 200px);
  }

  @media (orientation: landscape) {
    .study-timer-stage[data-fullscreen="true"] .flip-clock {
      --flip-size: clamp(90px, 26vh, 240px);
    }
    .study-timer-stage[data-fullscreen="true"] .compact-controls-wrapper {
      margin-top: 12px !important;
    }
    .study-timer-stage[data-fullscreen="true"] {
      padding: 12px 24px !important;
    }
    .study-timer-stage[data-fullscreen="true"] .voice-toggle-wrapper {
      top: 16px !important;
      right: 24px !important;
    }
  }
</style>
