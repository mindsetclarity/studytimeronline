---
// Our planner app. Styled with the site's own tokens so it reads as part of the site, not an ad.
const PLAY_URL = "https://play.google.com/store/apps/details?id=com.daystair.app";
---

<section class="container-page daystair" aria-labelledby="daystair-heading">
  <div class="card daystair__card">
    <video
      class="daystair__video"
      src="/media/daystair-tour.mp4"
      poster="/assets/daystair-tour-poster.jpg"
      width="1280"
      height="720"
      muted
      loop
      playsinline
      controls
      preload="none"
      aria-label="Daystair app tour"
      data-daystair-video
    ></video>

    <div class="daystair__body">
      <div>
        <p class="daystair__eyebrow">From the makers of Study Timer Online</p>
        <h2 id="daystair-heading">Plan big. Do today. Scroll less.</h2>
        <p class="daystair__lede">
          Daystair is a goal planner, day planner, habit tracker and focus timer in one Android app, with a
          friendly panda that counts your reels. Set a big goal, break it into small steps, and each day shows
          the tasks that move you forward.
        </p>
      </div>

      <div class="daystair__aside">
        <ul class="daystair__points">
          <li>Free, no ads</li>
          <li>Works offline</li>
          <li>Home screen widgets</li>
        </ul>
        <a class="daystair__cta" href={PLAY_URL} target="_blank" rel="noopener">
          <img src="/assets/daystair-panda.png" alt="" width="32" height="32" />
          Get Daystair on Google Play
        </a>
      </div>
    </div>

    <div class="daystair__features">
      <div>
        <h3>🐼 Count reels, scroll less</h3>
        <p>
          One reel turns into fifty before you notice. Reel Panda floats on your screen and counts every
          Instagram Reel and YouTube Short as you watch. Set your own daily limit, and when you pass it the
          panda reminds you what you planned instead. Optional, and off until you turn it on.
        </p>
      </div>
      <div>
        <h3>🪜 Big goals, small steps</h3>
        <p>
          The Goal Ladder runs Year → Quarter → Month → Week → Day. Link any task to a bigger goal and watch
          the progress climb. Your Top 3, timetable and to-do list sit together on one screen, and yesterday's
          unfinished tasks wait for you to keep, move or skip.
        </p>
      </div>
      <div>
        <h3>🎧 Deep focus, zero noise</h3>
        <p>
          A Pomodoro timer with your own focus and break lengths, calm wallpapers and a live countdown in your
          notifications. Keep an optional floating timer bar over other apps, block the apps you choose while
          you focus, and see focus time by category.
        </p>
      </div>
      <div>
        <h3>🌱 Habits that actually stick</h3>
        <p>
          Daily ticks, streaks and a monthly score, plus a mood log and planned-vs-done stats. Write by hand on
          50+ real planner pages with stickers, and turn on packs for studies (subjects, exams, mock tests),
          content or business.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  // Load and play only once the card is on screen, so the homepage stays light.
  const video = document.querySelector<HTMLVideoElement>("[data-daystair-video]");
  if (video && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    new IntersectionObserver(([entry]) => {
      if (entry.isIntersecting) video.play().catch(() => {});
      else video.pause();
    }, { threshold: 0.4 }).observe(video);
  }
</script>

<style>
  .daystair {
    padding-block: 2rem 1rem;
    max-width: 880px;
    margin: 0 auto;
  }

  .daystair__card {
    padding: clamp(12px, 2vw, 16px);
    border-radius: 28px;
  }

  .daystair__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 18px;
    background: var(--overlay-04);
  }

  .daystair__body {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    align-items: end;
    gap: 1.5rem 2rem;
    padding: clamp(16px, 4vw, 32px);
  }

  .daystair__eyebrow {
    color: var(--brand-amber);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 0.5rem;
  }

  .daystair h2 {
    color: var(--content-heading);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0;
  }

  .daystair__lede {
    color: var(--content-body);
    line-height: 1.7;
    margin: 0.75rem 0 0;
  }

  .daystair__points {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .daystair__points li {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--content-body);
    background: var(--overlay-04);
    border-radius: 999px;
    padding: 0.35rem 0.85rem;
  }

  .daystair__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    margin-top: 1rem;
    padding: 0.45rem 1.1rem 0.45rem 0.5rem;
    border-radius: 999px;
    background: var(--brand);
    color: var(--surface-page);
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--motion-fast) var(--motion-ease-press);
  }

  .daystair__cta:hover {
    transform: translateY(-1px);
  }

  .daystair__cta img {
    border-radius: 8px;
  }

  .daystair__features {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    padding: 0 clamp(16px, 4vw, 32px) clamp(16px, 4vw, 32px);
  }

  .daystair__features > div {
    background: var(--overlay-04);
    border-radius: 18px;
    padding: 1.1rem 1.25rem;
  }

  .daystair h3 {
    color: var(--content-heading);
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
  }

  .daystair__features p {
    color: var(--content-body);
    font-size: 0.92rem;
    line-height: 1.65;
    margin: 0;
  }

  @media (max-width: 640px) {
    .daystair__body,
    .daystair__features {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .daystair__cta {
      transition: none;
    }
  }
</style>
