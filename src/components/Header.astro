---
import { BRAND } from "../lib/brand";
import { NAV_LINKS, isCurrent } from "../lib/navigation";

const pathname = Astro.url.pathname;
const normalize = (path: string) => (path.endsWith("/") && path.length > 1 ? path.slice(0, -1) : path);
const normalizedPathname = normalize(pathname);
const activeLink = NAV_LINKS.find((link) => isCurrent(pathname, link.href));
const isHome = isCurrent(pathname, "/");
const PAGE_LABELS: Record<string, string> = {
  "/study-planner": "Planner",
  "/study-stats": "Stats",
  "/about": "About Us",
  "/privacy": "Privacy Policy",
  "/terms": "Terms & Conditions",
  "/contact": "Contact Us",
};
const activeLabel = activeLink?.label ?? PAGE_LABELS[normalizedPathname] ?? "Study";
---

<header class="site-header" data-site-header>
  <div class="site-header__inner">
    <div class="site-header__left">
      {!isHome && (
        <a class="site-back-link" href="/" aria-label="Go back" data-back-link>
          <span aria-hidden="true">&larr;</span>
        </a>
      )}
  
      <a class="brand-mark" href="/" aria-label={`${BRAND} home`} translate="no">
        <span class="brand-mark__glyph" aria-hidden="true">ST</span>
        <span class="brand-mark__text">
          <strong>{BRAND}</strong>
          <span>{activeLabel}</span>
        </span>
      </a>
    </div>


    <div class="site-header__actions">
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark theme">
        <span class="theme-toggle__icon theme-toggle__icon--sun" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
        </span>
        <span class="theme-toggle__icon theme-toggle__icon--moon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
          </svg>
        </span>
      </button>

      <button class="btn-secondary btn-sm mobile-menu-button" type="button" data-menu-button aria-controls="mobile-menu" aria-expanded="false">
        <span class="mobile-menu-button__icon" aria-hidden="true"><span></span><span></span></span>
        <span class="mobile-menu-button__text">Menu</span>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="mobile-menu" aria-label="Mobile navigation" data-mobile-menu hidden>
    {NAV_LINKS.map((link) => (
      <a class="mobile-menu__link" href={link.href} aria-current={isCurrent(pathname, link.href) ? "page" : undefined}>
        <span>{link.label}</span>
      </a>
    ))}
  </nav>
</header>
<style>
  /* Only the icon for the theme you would switch TO is shown. */
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: 999px;
    border: 1px solid var(--overlay-10);
    background: var(--overlay-04);
    color: var(--content-body);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }

  .theme-toggle:hover {
    color: var(--content-heading);
    border-color: var(--overlay-20);
    background: var(--overlay-08);
  }

  .theme-toggle:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 2px;
  }

  .theme-toggle__icon svg {
    width: 18px;
    height: 18px;
    display: block;
  }

  .theme-toggle__icon--sun { display: none; }
  .theme-toggle__icon--moon { display: block; }

  :root[data-theme="dark"] .theme-toggle__icon--sun { display: block; }
  :root[data-theme="dark"] .theme-toggle__icon--moon { display: none; }
</style>
