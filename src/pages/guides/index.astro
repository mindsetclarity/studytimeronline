---
import Layout from "../../layouts/Layout.astro";

interface Guide {
  url: string;
  frontmatter: { title: string; summary: string; published: string; updated?: string };
}

const guides = (Object.values(import.meta.glob("./*.md", { eager: true })) as Guide[]).sort((a, b) =>
  (b.frontmatter.updated ?? b.frontmatter.published).localeCompare(a.frontmatter.updated ?? a.frontmatter.published),
);
---

<Layout
  title="Study Guides"
  description="Practical study guides: the Pomodoro Technique, session length, study breaks, revision timetables, procrastination, phone distraction, active recall and timed practice exams."
  canonicalPath="/guides"
>
  <section class="page-band" style="padding-block: 3rem 6rem;">
    <div class="container-page" style="max-width: 860px; margin: 0 auto;">
      <header class="guides-head">
        <h1>Study guides</h1>
        <p>
          Short, practical guides on studying with a timer: how to pick a session length, pace a mock exam, and
          make revision stick. Each one is written to be used, not just read.
        </p>
      </header>
      <ul class="guides-list">
        {guides.map((g) => (
          <li class="card guides-list__item">
            <h2><a href={`${g.url}/`}>{g.frontmatter.title}</a></h2>
            <p>{g.frontmatter.summary}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .guides-head h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    color: var(--content-heading);
    margin: 0 0 0.75rem;
  }
  .guides-head p {
    color: var(--content-body);
    font-size: 1.05rem;
    line-height: 1.7;
    max-width: 62ch;
  }
  .guides-list {
    list-style: none;
    padding: 0;
    margin: 2rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .guides-list__item {
    padding: 1.5rem 1.75rem;
    border-radius: 20px;
  }
  .guides-list__item h2 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem;
  }
  .guides-list__item a {
    color: var(--content-heading);
    text-decoration: none;
  }
  .guides-list__item a:hover {
    color: var(--brand);
  }
  .guides-list__item p {
    margin: 0;
    color: var(--content-body);
    line-height: 1.6;
  }
</style>
