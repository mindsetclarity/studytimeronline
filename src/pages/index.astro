---
import Layout from "../layouts/Layout.astro";
import StudyTimerPanel from "../components/StudyTimerPanel.astro";
import DaystairPromo from "../components/DaystairPromo.astro";
import { BRAND } from "../lib/brand";

const description =
  "A free online study timer and Pomodoro timer with a planner, session stats and practical study guides. No sign-up; your progress stays in your browser.";

const faqList = [
  {
    q: "What is a study timer?",
    a: "<p>A study timer is a dedicated digital countdown or stopwatch tool designed to help students, self-learners, and professionals track their focus sessions. By partitioning study time into structured intervals, a study timer eliminates distractions, prevents cognitive fatigue, and builds consistent academic discipline.</p>"
  },
  {
    q: "How to use a study timer?",
    a: "<p>To use a study timer effectively, choose a single academic task or coursework assignment. Open Study Timer Online, select your preferred countdown duration (such as 25, 45, or 50 minutes), and click Start Focus. Put away distracting mobile devices and concentrate entirely on the task until the alarm chimes.</p>"
  },
  {
    q: "How to set a timer for study?",
    a: "<p>Setting a timer for study is instant with Study Timer Online. Simply navigate to our main Timer or Pomodoro page, use the compact duration chips or custom minute input box to select your desired timeframe, and click the start button. No account creation or app download is required.</p>"
  },
  {
    q: "What is a Pomodoro timer?",
    a: "<p>A Pomodoro timer is a timer built around the Pomodoro Technique. It alternates focused work blocks (traditionally 25 minutes) with short breaks (5 minutes), which makes long study sessions easier to start and sustain.</p>"
  },
  {
    q: "How does a Pomodoro timer work?",
    a: "<p>A Pomodoro timer works by breaking complex coursework into manageable cognitive cycles. During the focus sprint, your brain concentrates deeply on problem-solving. When the timer chimes, you enter a short break to rest your neural pathways. After completing four consecutive focus sprints, the timer initiates an extended long break (15 to 30 minutes) for complete mental restoration.</p>"
  },
  {
    q: "How to use a Pomodoro timer?",
    a: "<p>Using a Pomodoro timer involves four simple steps: select one specific study assignment, start a 25-minute focus countdown, work without interruption until the alarm rings, and take a 5-minute restorative break. Repeat this cycle to build academic momentum and overcome procrastination.</p>"
  },
  {
    q: "How to set a Pomodoro timer?",
    a: "<p>To set a Pomodoro timer on our platform, click on the Pomodoro tab in the navigation menu. Our engine automatically loads standard 25-minute focus and 5-minute break intervals. You can adjust these timings instantly in the compact settings panel to match your personal focus capacity before pressing start.</p>"
  },
  {
    q: "Why is it called a Pomodoro timer?",
    a: "<p>The Pomodoro timer is named after the Italian word for tomato (pomodoro). The technique was invented in the late 1980s by university student Francesco Cirillo, who utilized a kitchen timer shaped like a tomato to time his personal study intervals.</p>"
  },
  {
    q: "How to use Pomodoro timer apps effectively?",
    a: "<p>To use Pomodoro timer apps effectively, eliminate multitasking by committing to one task per sprint, respect the break alarms by stepping away from your desk, and choose browser-based local tools like Study Timer Online that do not bombard your screen with distracting pop-ups or social feeds.</p>"
  },
  {
    q: "How does Study Timer Online work?",
    a: "<p>Study Timer Online operates directly within your web browser using modern local-first web technology. When you start a timer, plan a study queue, or log completed focus blocks, all data is saved securely in your browser's local storage. That keeps it fast and means you never need to log in. Clearing your browser data removes it.</p>"
  },
  {
    q: "How does Study Timer Online compare with other Pomodoro timers?",
    a: "<p>Study Timer Online is free and needs no account or download. It focuses on a few things done well: a countdown timer, a Pomodoro timer, a simple daily planner and local session stats, plus <a href='/guides'>practical guides</a> on how to study with them.</p>"
  }
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqList.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout title={BRAND} description={description} canonicalPath="/">
  <section class="home-hero" data-home-first-impression>
    <div class="container-page home-hero__copy">
      <h1>Study in a calmer rhythm.</h1>
      <p class="home-hero__lede">Pick a length and start. No login, no install.</p>
    </div>
  </section>

  <!-- The timer is the product, so it is the hero — not a click away. -->
  <StudyTimerPanel />

  <section class="container-page home-hero__proof-band">
    <ul class="home-hero__proof" aria-label="Study Timer Online principles">
      <li>No login</li>
      <li>Private progress</li>
      <li>Mobile ready</li>
    </ul>
    <p class="home-hero__links">
      Prefer the classic 25/5 rhythm? <a href="/pomodoro">Open the Pomodoro timer</a> · <a href="/guides">Read the study guides</a> ·
      <a href="/study-planner">Plan today</a> · <a href="/study-stats">See your stats</a>
    </p>
  </section>

  <DaystairPromo />

  <section class="container-page seo-about-band" aria-labelledby="seo-main-heading" style="padding-block: 4rem 6rem; max-width: 880px; margin: 0 auto;">
    <article class="card" style="padding: clamp(28px, 6vw, 56px); border-radius: 28px; line-height: 1.8;">
      <header style="margin-bottom: 2.25rem; border-bottom: 1px solid var(--brand-a15); padding-bottom: 1.75rem;">
        <h2 id="seo-main-heading" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; color: var(--content-heading); line-height: 1.25; margin-bottom: 0.75rem;">How to get the most out of a study timer</h2>
        <p style="color: var(--brand); font-weight: 600; font-size: 1.05rem; margin: 0;">A timer won't study for you, but it does make starting and staying on track much easier.</p>
      </header>

      <div class="seo-article-body" style="display: flex; flex-direction: column; gap: 2rem; color: var(--content-body); font-size: 1.025rem;">
        <section>
          <h3 style="color: var(--content-heading); font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem;">Give every session one job</h3>
          <p style="margin: 0;">Before you press start, decide what the session is for, and make it specific. "Revise chemistry" is too vague to begin. "Redo the eight equilibrium questions I got wrong" tells you exactly what to do first and when you're finished. The timer then answers the other question that breaks concentration: "should I stop yet?" Not until it rings.</p>
        </section>

        <section>
          <h3 style="color: var(--content-heading); font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem;">Pick a length you can actually finish</h3>
          <p style="margin: 0;">Short blocks of 15–25 minutes suit flashcards and tasks you've been avoiding. Reading and most problem sets suit 30–50 minutes. Essays, coding and mock exams can run 60–90. If the timer keeps ringing in the middle of a thought, go longer. If you're checking the clock with ten minutes left, go shorter. Our guide on <a href="/guides/how-long-to-study" style="color: var(--brand);">how long a study session should be</a> covers this in more detail.</p>
        </section>

        <section>
          <h3 style="color: var(--content-heading); font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem;">Use the Pomodoro rhythm when starting is the hard part</h3>
          <p style="margin: 0;">The <a href="/pomodoro" style="color: var(--brand);">Pomodoro timer</a> alternates 25 minutes of focus with 5-minute breaks, and gives you a longer break after four rounds. It works because 25 minutes is short enough to start even when you don't feel like it, and the breaks are planned in advance, so you don't need to feel exhausted to earn them. Both lengths are adjustable. Read <a href="/guides/pomodoro-technique" style="color: var(--brand);">the Pomodoro Technique guide</a> for how to adapt it to different kinds of work.</p>
        </section>

        <section>
          <h3 style="color: var(--content-heading); font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem;">Test yourself, don't just reread</h3>
          <p style="margin: 0;">How you use a block matters more than its length. Writing out what you remember from memory, then checking it, beats rereading your notes, even though rereading feels easier. Spreading reviews of the same topic across several days beats one long session the night before. See <a href="/guides/active-recall-and-spaced-repetition" style="color: var(--brand);">active recall and spaced repetition</a> for a simple schedule.</p>
        </section>

        <section>
          <h3 style="color: var(--content-heading); font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem;">Practise under exam conditions</h3>
          <p style="margin: 0;">Set the <a href="/timer" style="color: var(--brand);">timer</a> to the exact length of your exam, work out how many minutes each mark is worth, and sit a past paper without pausing. The review afterwards is where the value is: sort lost marks into "didn't know it", "misread", "ran out of time" and "careless". <a href="/guides/timed-practice-exams" style="color: var(--brand);">How to run a timed practice exam</a> walks through the whole process.</p>
        </section>

        <section>
          <h3 style="color: var(--content-heading); font-size: 1.35rem; font-weight: 700; margin-bottom: 0.75rem;">Your progress stays on your device</h3>
          <p style="margin: 0;">There's no account to create. Your timer settings, <a href="/study-planner" style="color: var(--brand);">planner</a> tasks and session history are saved in your browser's local storage, and the <a href="/study-stats" style="color: var(--brand);">stats page</a> reads them back to show your daily minutes and streak. Clearing your browser data removes them. See the <a href="/privacy" style="color: var(--brand);">privacy policy</a> for what third-party services the site uses.</p>
        </section>
      </div>
    </article>
  </section>

  <section class="container-page seo-faq-band" aria-labelledby="seo-faq-heading" style="padding-block: 2rem 8rem; max-width: 880px; margin: 0 auto;">
    <header style="text-align: center; margin-bottom: 3.5rem;">
      <p class="eyebrow" style="color: var(--brand-amber); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 700; margin-bottom: 0.5rem;">frequently asked questions</p>
      <h2 id="seo-faq-heading" style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; color: var(--content-heading); margin: 0;">Study Timer & Pomodoro FAQ</h2>
    </header>

    <div class="faq-accordion-list" style="display: flex; flex-direction: column; gap: 1rem;">
      {faqList.map((item) => (
        <details class="card faq-item" style="padding: 1.5rem 1.75rem; border-radius: 20px; cursor: pointer; transition: border-color 0.2s ease;">
          <summary style="font-size: 1.125rem; font-weight: 700; color: var(--content-heading); outline: none; list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 1rem;">
            <span>{item.q}</span>
            <span class="faq-toggle-icon" aria-hidden="true" style="color: var(--brand); font-size: 1.5rem; font-weight: 400; line-height: 1;">+</span>
          </summary>
          <div style="margin-top: 1.25rem; color: var(--content-body); font-size: 1.025rem; line-height: 1.75; border-top: 1px solid var(--brand-a12); padding-top: 1.25rem;" set:html={item.a} />
        </details>
      ))}
    </div>
  </section>

  <style>
    .home-hero {
      padding: 1rem 0 0.75rem;
      text-align: center;
    }

    .home-hero h1 {
      font-size: clamp(1.75rem, 4.5vw, 2.4rem);
      line-height: 1.1;
      margin: 0.5rem 0 0;
    }

    .home-hero__lede {
      color: var(--content-body);
      font-size: 1.05rem;
      margin: 0.6rem auto 0;
      max-width: 52ch;
    }

    .home-hero__proof-band {
      padding-bottom: 1rem;
      text-align: center;
    }

    .home-hero__proof {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 0.5rem;
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .home-hero__proof li {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--content-body);
      background: var(--overlay-04);
      border-radius: 999px;
      padding: 0.35rem 0.85rem;
    }

    .home-hero__links {
      color: var(--content-body);
      font-size: 0.9rem;
      margin: 1.25rem 0 0;
    }

    .home-hero__links a {
      color: var(--brand);
    }

    details > summary::-webkit-details-marker {
      display: none;
    }
    details[open] > summary .faq-toggle-icon {
      transform: rotate(45deg);
    }
    .faq-toggle-icon {
      display: inline-block;
      transition: transform 0.2s ease;
    }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</Layout>