---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" description="Contact Study Timer Online with feedback, bugs, and timer feature requests." canonicalPath="/contact">
  <section class="page-band">
    <div class="container-page timer-layout">
      <div class="legal-copy">
        <p class="eyebrow">contact</p>
        <h1>Feedback helps shape the timers.</h1>
        <p>Found a bug, have a launch request, or want a new timing mode? Send a concise note with the page, browser, device, and what happened.</p>
      </div>
      <aside class="settings-card card">
        <h2>Contact options</h2>
        <p>For v1, contact is intentionally simple and does not require a backend form.</p>
        <a class="btn-primary" href="mailto:mindsetclarityofficial@gmail.com?subject=Study%20Timer%20Online%20feedback">Email Feedback</a>
        <p class="form-hint">A backend contact form can be added later if needed.</p>
      </aside>
    </div>
  </section>
</Layout>