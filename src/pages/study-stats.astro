---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Study Stats" description="Private study progress on this device." canonicalPath="/study-stats">
  <style>
    .compact-stats {
      max-width: 1080px;
      margin: 0 auto;
      padding: 2rem 1rem 4rem;
      color: #f8fafc;
      font-family: var(--font-sans, system-ui, sans-serif);
    }
    .stats-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
    }
    .stats-header h1 {
      font-size: 2rem;
      font-weight: 600;
      margin: 0 0 0.25rem 0;
      color: #f8fafc;
    }
    .stats-header p {
      color: #64748b;
      margin: 0;
      font-size: 0.95rem;
    }
    .btn-outline {
      border: 1px solid rgba(45, 212, 191, 0.25);
      color: #2dd4bf;
      padding: 8px 16px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 0.9rem;
      font-weight: 500;
      transition: all 0.2s;
    }
    .btn-outline:hover {
      background: rgba(45, 212, 191, 0.1);
      border-color: rgba(45, 212, 191, 0.4);
    }
    
    .grid-overview {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
      margin-bottom: 1.5rem;
    }
    .stat-card {
      background: linear-gradient(145deg, rgba(15, 23, 42, 0.5), rgba(9, 14, 23, 0.8));
      border: 1px solid rgba(148, 163, 184, 0.1); /* Subtle blue-gray */
      border-radius: 12px;
      padding: 1.25rem;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.02);
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: center;
      height: 120px;
    }
    .stat-card:hover {
      border-color: rgba(45, 212, 191, 0.25);
      box-shadow: 0 8px 25px rgba(45, 212, 191, 0.05), inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    .stat-card span {
      font-size: 0.75rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      display: block;
      margin-bottom: 0.5rem;
    }
    .stat-card strong {
      font-size: 1.5rem;
      font-weight: 600;
      color: #2dd4bf; /* Important numbers in teal */
      display: block;
      line-height: 1.2;
    }
    .stat-card strong:not(.tabular) {
      color: #e2e8f0; /* Consistency text not pure teal */
      font-size: 1.15rem;
    }

    .grid-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }
    
    .details-column {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .panel {
      background: rgba(15, 23, 42, 0.3);
      border: 1px solid rgba(148, 163, 184, 0.08);
      border-radius: 16px;
      padding: 1.5rem;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);
    }
    .panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
    }
    .panel-header h2 {
      font-size: 1.05rem;
      font-weight: 600;
      margin: 0;
      color: #f8fafc;
    }
    .panel-header span {
      font-size: 0.8rem;
      color: #64748b;
    }
    
    .rhythm-group {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }
    .rhythm-label {
      font-size: 0.8rem;
      margin: 0 0 0.75rem;
      color: #94a3b8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Weekly Bars */
    .weekly-bars {
      display: flex;
      align-items: flex-end;
      gap: 6px;
      height: 120px;
    }
    .weekly-bar {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
    }
    .weekly-bar__track {
      width: 100%;
      max-width: 32px;
      height: 90px;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 4px;
      display: flex;
      align-items: flex-end;
      overflow: hidden;
    }
    .weekly-bar__track span {
      width: 100%;
      background: #2dd4bf;
      border-radius: 4px;
      transition: height 0.5s ease;
    }
    .weekly-bar strong {
      font-size: 0.75rem;
      color: #e2e8f0;
    }
    .weekly-bar small {
      font-size: 0.7rem;
      color: #64748b;
    }

    /* Heatmap */
    .study-heatmap {
      display: flex;
      flex-wrap: wrap;
      gap: 3px;
    }
    .study-heatmap__cell {
      width: 12px;
      height: 12px;
      background: rgba(255, 255, 255, 0.03);
      border-radius: 2px;
    }
    .study-heatmap__cell[data-level="1"] { background: rgba(45, 212, 191, 0.2); }
    .study-heatmap__cell[data-level="2"] { background: rgba(45, 212, 191, 0.4); }
    .study-heatmap__cell[data-level="3"] { background: rgba(45, 212, 191, 0.7); }
    .study-heatmap__cell[data-level="4"] { background: #2dd4bf; }
    
    /* Subjects */
    .empty-state {
      font-size: 0.85rem;
      color: #64748b;
      margin: 0;
    }
    .subject-breakdown {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 1rem;
    }
    .subject-breakdown li {
      display: grid;
      gap: 6px;
    }
    .subject-breakdown li div {
      display: flex;
      justify-content: space-between;
      font-size: 0.85rem;
      color: #e2e8f0;
    }
    .subject-breakdown__track {
      height: 4px;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 2px;
      overflow: hidden;
    }
    .subject-breakdown__track span {
      display: block;
      height: 100%;
      background: #2dd4bf;
      border-radius: 2px;
    }

    /* Sessions */
    .session-list {
      list-style: none;
      padding: 0;
      margin: 0;
      display: grid;
      gap: 0.5rem;
    }
    .session-list li {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.03);
      padding: 10px 14px;
      border-radius: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .session-list strong {
      font-size: 0.9rem;
      display: block;
      margin-bottom: 2px;
      color: #f8fafc;
    }
    .session-list small {
      font-size: 0.75rem;
      color: #64748b;
    }
    .session-history__chips {
      display: flex;
      gap: 6px;
    }
    .session-history__chips span {
      font-size: 0.75rem;
      background: rgba(45, 212, 191, 0.08);
      color: #2dd4bf;
      padding: 2px 6px;
      border-radius: 4px;
    }

    @media (max-width: 900px) {
      .grid-overview { grid-template-columns: repeat(3, 1fr); }
      .grid-details { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) {
      .stats-header { flex-direction: column; align-items: flex-start; gap: 1rem; }
      .grid-overview { grid-template-columns: repeat(2, 1fr); }
      .grid-overview .stat-card:last-child { grid-column: span 2; }
      .session-list li { flex-direction: column; align-items: flex-start; gap: 6px; }
      .session-history__chips { margin-left: 0; }
    }
  </style>

  <section class="compact-stats" data-study-stats>
    <header class="stats-header">
      <div>
        <h1>Stats</h1>
        <p>Private study progress on this device.</p>
      </div>
      <a class="btn-outline" href="/study-planner">Open Planner</a>
    </header>

    <div class="grid-overview">
      <div class="stat-card">
        <span>Today</span>
        <strong class="tabular" data-stat-today>0 min</strong>
      </div>
      <div class="stat-card">
        <span>This Week</span>
        <strong class="tabular" data-stat-week>0 min</strong>
      </div>
      <div class="stat-card">
        <span>Sessions</span>
        <strong class="tabular" data-stat-sessions>0</strong>
      </div>
      <div class="stat-card">
        <span>Average</span>
        <strong class="tabular" data-stat-average>0 min</strong>
      </div>
      <div class="stat-card">
        <span>Consistency</span>
        <strong data-stat-streak>Quiet start</strong>
      </div>
    </div>

    <div class="grid-details">
      <div class="panel">
        <div class="panel-header">
          <h2>Rhythm</h2>
          <span>Local history</span>
        </div>
        <div class="rhythm-group">
          <div>
            <h3 class="rhythm-label">Last 7 Days <span data-week-range style="float:right; font-weight:normal; text-transform:none;"></span></h3>
            <div class="weekly-bars" data-weekly-bars></div>
          </div>
          <div>
            <h3 class="rhythm-label">21-Day Heatmap</h3>
            <div class="study-heatmap" data-study-heatmap></div>
          </div>
        </div>
      </div>

      <div class="details-column">
        <div class="panel">
          <div class="panel-header">
            <h2>Subject Time</h2>
            <span data-subject-total>0 min</span>
          </div>
          <p class="empty-state" data-subject-empty>No subject data yet.</p>
          <ul class="subject-breakdown" data-subject-breakdown></ul>
        </div>
        
        <div class="panel">
          <div class="panel-header">
            <h2>Recent Sessions</h2>
            <span>Stored locally</span>
          </div>
          <p class="empty-state" data-session-empty>No completed sessions yet. Start a timer from Planner to build your stats.</p>
          <ol class="session-list" data-session-list></ol>
        </div>
      </div>
    </div>
  </section>

  <script>
    import "../scripts/study-stats";
  </script>
</Layout>